# Copy to .env and fill in. NEVER commit .env or paste keys into chat/Discord.

# --- AI: DeepSeek (our chosen model) -------------------------------------
# Key from https://platform.deepseek.com/api_keys (team account, pay-as-you-go).
# Without a key the app still works on rules only.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Seconds between AI calls (DeepSeek has no tight rate limit)
LLM_MIN_INTERVAL=0.5

# --- Scanned PDFs: Gemini free tier (optional) ------------------------------
# DeepSeek can't read scans. With this key set, Gemini reads them (free, no card):
# https://aistudio.google.com/apikey — DeepSeek still does everything else.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Alternatives (free) ---------------------------------------------------
# Use Gemini for everything: LLM_PROVIDER=gemini and LLM_MIN_INTERVAL=4
# Any OpenAI-compatible endpoint (Groq free tier, OpenRouter, local Ollama):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Cloud database (optional; free Supabase project, no card) -----------
# Stores human reviews + uploaded emails so they survive restarts.
# Run docs/supabase.sql in the Supabase SQL editor first.
<@852722152691466241> 

SUPABASE_URL= https://sadxrixppyuaxsvrqrbw.supabase.co/
SUPABASE_KEY=

# --- Display name -------------------------------------------------------
APP_NAME=ShipCheck
